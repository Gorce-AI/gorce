{
  "name": "@gorce-ai/gorce-core",
  "version": "0.1.0",
  "description": "Sovereign execution tooling for the Gorce core repository",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "bunx biome check .",
