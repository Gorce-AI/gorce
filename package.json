{
  "name": "@gorce-ai/gorce-core",
  "version": "0.0.0",
  "private": true,
  "description": "Core-first TypeScript/Bun preview workspace",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run build:native",
    "lint": "bunx biome check --error-on-warnings .",
    "test": "bun test",
    "test:mutation": "bun src/commands/test-mutation-s2.ts",
    "typecheck": "bun src/commands/typecheck-s1.ts",
    "build:native": "bun src/commands/build-native.ts",
    "verify:s1": "bun src/commands/verify-s1.ts --strict",
    "verify:s1-cutover": "bun src/commands/verify-s1.ts --strict",
    "verify:s2": "bun src/commands/verify-s2.ts --strict",
    "verify:reproducible": "bun src/commands/verify-reproducible.ts",
    "verify:native": "bun src/commands/verify-native.ts",
    "verify:native:index": "bun src/commands/index-native-evidence.ts",
    "audit": "bun audit",
    "verify:bootstrap": "bun src/commands/verify-bootstrap.ts",
    "qa:task": "bun src/commands/qa-task.ts",
    "verify:plan-compliance": "bun src/commands/verify-plan-compliance.ts",
    "docs:verify": "bun src/commands/docs-verify.ts",
    "verify:evidence": "bun src/commands/evidence.ts",
    "verify:technology": "bun src/commands/verify-technology.ts",
    "verify:architecture": "bun src/commands/verify-architecture.ts",
    "architecture:hash-rules": "bun src/commands/hash-rules.ts",
    "verify:architecture:ecosystem": "bun src/commands/verify-architecture-ecosystem.ts"
  },
  "devDependencies": {
    "@gorce-ai/core": "workspace:*",
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
