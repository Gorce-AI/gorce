{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.dev/schemas/operator-profile.schema.json",
  "title": "OperatorProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "kind", "status", "skills", "permission_scopes", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "display_name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["human", "agent", "service"] },
    "status": { "type": "string", "enum": ["active", "suspended"] },
    "skills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "permission_scopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
