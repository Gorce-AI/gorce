{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.dev/schemas/health.schema.json",
  "title": "Health",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "version"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "degraded"]
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "status": "ok",
      "version": "0.1.0"
    }
  ]
}
