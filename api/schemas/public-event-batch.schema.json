{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.dev/schemas/public-event-batch.schema.json",
  "title": "PublicEventBatch",
  "description": "Paginated, read-only public event response. Cursors are opaque and must be reused verbatim; clients must not require numeric contiguity for correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cursor", "events", "has_more"],
  "properties": {
    "cursor": {
      "$ref": "https://gorce.dev/schemas/public-event-cursor.schema.json"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "https://gorce.dev/schemas/public-event.schema.json"
      }
    },
    "next_cursor": {
      "oneOf": [
        { "$ref": "https://gorce.dev/schemas/public-event-cursor.schema.json" },
        { "type": "null" }
      ]
    },
    "has_more": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "has_more": { "const": true } } },
      "then": { "required": ["next_cursor"] }
    }
  ],
  "examples": [
    {
      "cursor": "g1-0-0",
      "events": [
        {
          "id": "018f0f5e-7b12-7abf-8def-0123456789ab",
          "project_id": "018f0f5e-7b12-7abc-8def-0123456789ab",
          "sequence": 1,
          "event_type": "task.created",
          "occurred_at": "2026-01-01T00:00:00Z",
          "payload": { "task_id": "018f0f5e-7b12-7abe-8def-0123456789ab" }
        }
      ],
      "next_cursor": "g1-1-0",
      "has_more": true
    }
  ]
}
