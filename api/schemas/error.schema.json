{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.dev/schemas/error.schema.json",
  "title": "Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "conflict",
        "precondition_failed",
        "rate_limited",
        "service_not_ready",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "details": {}
  },
  "examples": [
    {
      "code": "invalid_request",
      "message": "The request body is invalid.",
      "request_id": "req_01hqz7b4m9r7"
    }
  ]
}
