{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.dev/schemas/error.schema.json",
  "title": "Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "code": "service_not_ready",
      "message": "The service is not ready."
    }
  ]
}
