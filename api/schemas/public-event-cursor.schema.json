{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.dev/schemas/public-event-cursor.schema.json",
  "title": "PublicEventCursor",
  "description": "Opaque cursor for the append-only public event stream.",
  "type": "string",
  "minLength": 1,
  "maxLength": 512,
  "pattern": "^[A-Za-z0-9._~-]+$",
  "examples": ["eyJzZXF1ZW5jZSI6MX0"]
}
