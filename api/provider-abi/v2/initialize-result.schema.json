{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.dev/schemas/provider-abi/v2/initialize-result.schema.json",
  "title": "gorce.provider/v2 initialize result representation",
  "$comment": "Runtime capabilities and descriptors must equal the approved V2 manifest; this equality is semantic and is enforced by the Rust ABI module.",
  "type": "object",
  "additionalProperties": false,
  "required": ["abi_version", "provider_id", "package_digest", "tools", "capabilities"],
  "properties": {
    "abi_version": {"const": "gorce.provider/v2"},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tools": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/toolDescriptor"}},
    "capabilities": {"$ref": "#/$defs/runtimeCapabilities"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "toolId": {"type": "string", "pattern": "^gorce\\.provider/v2/tool/[0-9a-f]{64}/[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"},
    "policyId": {"enum": ["gorce.official-cli/codex/v1", "gorce.official-cli/claude-code/v1"]},
    "authentication": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "none"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "auth_method_id", "credential_class", "delivery_kind"], "properties": {"kind": {"const": "host_secret"}, "auth_method_id": {"$ref": "#/$defs/identifier"}, "credential_class": {"$ref": "#/$defs/identifier"}, "delivery_kind": {"enum": ["api_key", "access_token"]}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "policy_id"], "properties": {"kind": {"const": "official_cli_session"}, "policy_id": {"$ref": "#/$defs/policyId"}}}
    ]},
    "localSchema": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": {"enum": ["object", "array", "string", "integer", "number", "boolean", "null"]},
        "title": {"type": "string"}, "description": {"type": "string"},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/localSchema"}},
        "required": {"type": "array", "items": {"type": "string"}},
        "items": {"$ref": "#/$defs/localSchema"}, "additionalProperties": {"type": "boolean"},
        "enum": {"type": "array", "minItems": 1, "maxItems": 32}, "const": {},
        "minLength": {"type": "integer", "minimum": 0, "maximum": 4096}, "maxLength": {"type": "integer", "minimum": 0, "maximum": 4096},
        "minimum": {"type": "number"}, "maximum": {"type": "number"},
        "minItems": {"type": "integer", "minimum": 0, "maximum": 256}, "maxItems": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "sideEffect": {"enum": ["none", "network_read", "network_write", "local_write"]},
    "toolDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_id", "name", "description", "input_schema", "output_schema", "side_effects", "authentication", "network_origins"],
      "properties": {
        "tool_id": {"$ref": "#/$defs/toolId"}, "name": {"$ref": "#/$defs/identifier"}, "description": {"type": "string", "minLength": 1},
        "input_schema": {"$ref": "#/$defs/localSchema"}, "output_schema": {"$ref": "#/$defs/localSchema"},
        "side_effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sideEffect"}},
        "authentication": {"$ref": "#/$defs/authentication"}, "network_origins": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "runtimeCapabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["auth_method_ids", "tool_ids", "credential_classes", "network_origins", "side_effects", "official_cli_policy_ids"],
      "properties": {
        "auth_method_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "tool_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/toolId"}},
        "credential_classes": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "network_origins": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
        "side_effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sideEffect"}},
        "official_cli_policy_ids": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/policyId"}}
      }
    }
  }
}
