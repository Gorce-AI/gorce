{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gorce.provider/v1/source.schema.json",
  "title": "Resolved provider source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "source_content_digest_algorithm",
    "source_content_digest",
    "manifest_mode",
    "manifest",
    "manifest_digest",
    "files",
    "executable"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_git_url", "commit_hash_algorithm", "resolved_commit"],
      "properties": {
        "canonical_git_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "commit_hash_algorithm": {"enum": ["sha1", "sha256"]},
        "resolved_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]+$",
          "minLength": 40,
          "maxLength": 64
        }
      }
    },
    "source_content_digest_algorithm": {
      "const": "sha256:gorce.provider/source-content/v1"
    },
    "source_content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_mode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "manifest": {"type": "string", "minLength": 1, "maxLength": 262144},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "mode", "size", "sha256", "content"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {
            "enum": ["regular_file", "symlink", "gitlink", "directory", "special"]
          },
          "mode": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295},
          "size": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content": {
            "type": "array",
            "maxItems": 67108864,
            "items": {"type": "integer", "minimum": 0, "maximum": 255}
          }
        }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "size": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
