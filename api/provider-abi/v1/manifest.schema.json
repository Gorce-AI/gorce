{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.dev/schemas/provider-abi/v1/manifest.schema.json",
  "title": "gorce.provider/v1 signed manifest",
  "$comment": "Manifest text maxLength values count Unicode scalar values. ASCII identifiers and package paths are byte-bounded; RPC UTF-8 byte-bounded fields are documented in rpc.schema.json and checked semantically by the host.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "provider_id", "display_name", "version", "publisher", "package", "auth_methods", "capabilities", "tools"],
  "properties": {
    "format": {"const": "gorce.provider/v1"},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
    "version": {"type": "string", "pattern": "^(?:0+|0*[1-9][0-9]{0,18}|0*1[0-7][0-9]{18}|0*18[0-3][0-9]{17}|0*184[0-3][0-9]{16}|0*1844[0-5][0-9]{15}|0*18446[0-6][0-9]{14}|0*184467[0-3][0-9]{13}|0*1844674[0-3][0-9]{12}|0*184467440[0-6][0-9]{10}|0*1844674407[0-2][0-9]{9}|0*18446744073[0-6][0-9]{8}|0*1844674407370[0-8][0-9]{6}|0*18446744073709[0-4][0-9]{5}|0*184467440737095[0-4][0-9]{4}|0*1844674407370955[0][0-9]{3}|0*18446744073709551[0-5][0-9]{2}|0*184467440737095516[0][0-9]|0*1844674407370955161[0-4]|0*18446744073709551615)\\.(?:0+|0*[1-9][0-9]{0,18}|0*1[0-7][0-9]{18}|0*18[0-3][0-9]{17}|0*184[0-3][0-9]{16}|0*1844[0-5][0-9]{15}|0*18446[0-6][0-9]{14}|0*184467[0-3][0-9]{13}|0*1844674[0-3][0-9]{12}|0*184467440[0-6][0-9]{10}|0*1844674407[0-2][0-9]{9}|0*18446744073[0-6][0-9]{8}|0*1844674407370[0-8][0-9]{6}|0*18446744073709[0-4][0-9]{5}|0*184467440737095[0-4][0-9]{4}|0*1844674407370955[0][0-9]{3}|0*18446744073709551[0-5][0-9]{2}|0*184467440737095516[0][0-9]|0*1844674407370955161[0-4]|0*18446744073709551615)\\.(?:0+|0*[1-9][0-9]{0,18}|0*1[0-7][0-9]{18}|0*18[0-3][0-9]{17}|0*184[0-3][0-9]{16}|0*1844[0-5][0-9]{15}|0*18446[0-6][0-9]{14}|0*184467[0-3][0-9]{13}|0*1844674[0-3][0-9]{12}|0*184467440[0-6][0-9]{10}|0*1844674407[0-2][0-9]{9}|0*18446744073[0-6][0-9]{8}|0*1844674407370[0-8][0-9]{6}|0*18446744073709[0-4][0-9]{5}|0*184467440737095[0-4][0-9]{4}|0*1844674407370955[0][0-9]{3}|0*18446744073709551[0-5][0-9]{2}|0*184467440737095516[0][0-9]|0*1844674407370955161[0-4]|0*18446744073709551615)$"},
    "publisher": {
      "type": "object", "additionalProperties": false, "required": ["name", "fingerprint"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"}, "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "package": {
      "type": "object", "additionalProperties": false, "required": ["files", "executable"],
      "properties": {
        "files": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/packagePath"},
              "size": {"type": "integer", "minimum": 0, "maximum": 67108864},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "executable": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"$ref": "#/$defs/packagePath"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    },
    "auth_methods": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false, "required": ["kind", "id", "credential_class", "label"],
            "properties": {"kind": {"const": "api_key"}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "credential_class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "label": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"}}
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "id", "credential_class", "label", "client_type", "client_id", "authorization_endpoint", "token_endpoint", "approved_origins", "scopes", "callback", "grant_type", "pkce_method"],
            "properties": {
              "kind": {"const": "oauth_authorization_code_pkce"}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "credential_class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "label": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
              "client_type": {"const": "public"}, "client_id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"}, "authorization_endpoint": {"$ref": "#/$defs/httpsUrl"}, "token_endpoint": {"$ref": "#/$defs/httpsUrl"},
              "approved_origins": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/httpsOrigin"}}, "scopes": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"}},
              "callback": {"const": "host_managed"}, "grant_type": {"const": "authorization_code"}, "pkce_method": {"const": "S256"}
            }
          }
        ]
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false, "required": ["auth_method_ids", "credential_classes", "network_origins"],
      "properties": {
        "auth_method_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}},
        "credential_classes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}},
        "network_origins": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/httpsOrigin"}}
      }
    },
    "tools": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "description", "input_schema", "output_schema", "side_effects", "auth_method_id", "credential_class", "network_origins"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "description": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
          "input_schema": {"allOf": [{"$ref": "#/$defs/localSchema"}, {"type": "object", "required": ["type"], "properties": {"type": {"const": "object"}}}]}, "output_schema": {"$ref": "#/$defs/localSchema"},
          "side_effects": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"enum": ["none", "network_read", "network_write", "local_write"]}},
          "auth_method_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "credential_class": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "network_origins": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/httpsOrigin"}}
        }
      }
    }
  },
  "$defs": {
    "localSchema": {
      "$comment": "Local schema metadata and string lengths count Unicode scalar values; property names are limited to 128 UTF-8 bytes by Rust/Python semantic validation.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["object", "array", "string", "integer", "number", "boolean", "null"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
        "properties": {"type": "object", "maxProperties": 64, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"}, "additionalProperties": {"$ref": "#/$defs/localSchema"}},
        "required": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}},
        "items": {"$ref": "#/$defs/localSchema"},
        "additionalProperties": {"type": "boolean"},
        "enum": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true},
        "const": {},
        "minLength": {"type": "integer", "minimum": 0, "maximum": 4096},
        "maxLength": {"type": "integer", "minimum": 0, "maximum": 4096},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "minItems": {"type": "integer", "minimum": 0, "maximum": 256},
        "maxItems": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "packagePath": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:[mM][aA][nN][iI][fF][eE][sS][tT]\\.[jJ][sS][oO][nN]|[sS][iI][gG][nN][aA][tT][uU][rR][eE]\\.[jJ][sS][oO][nN])(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[!-~]*\\.(?:/|$))(?!.*(?:^|/)(?:[cC][oO][nN]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][lL][oO][cC][kK]\\$|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.[!-~]*)?(?:/|$))(?!.*[:\\\\<>\"|?*])[!-~]+$"},
    "httpsUrl": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://(?:(?!(?:(?:[0-9]+|0x[0-9a-f]*)\\.)*(?:[0-9]+|0x[0-9a-f]*)(?::|/|$))[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*|\\[(?:(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}|(?:[0-9a-f]{1,4}:){1,7}:|(?:[0-9a-f]{1,4}:){1,6}:[0-9a-f]{1,4}|(?:[0-9a-f]{1,4}:){1,5}(?::[0-9a-f]{1,4}){1,2}|(?:[0-9a-f]{1,4}:){1,4}(?::[0-9a-f]{1,4}){1,3}|(?:[0-9a-f]{1,4}:){1,3}(?::[0-9a-f]{1,4}){1,4}|(?:[0-9a-f]{1,4}:){1,2}(?::[0-9a-f]{1,4}){1,5}|[0-9a-f]{1,4}:(?:(?::[0-9a-f]{1,4}){1,6})|:(?:(?::[0-9a-f]{1,4}){1,7}|:))\\]|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))(?!:443(?:/|$))(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$"},
    "httpsOrigin": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://(?:(?!(?:(?:[0-9]+|0x[0-9a-f]*)\\.)*(?:[0-9]+|0x[0-9a-f]*)(?::|/|$))[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*|\\[(?:(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}|(?:[0-9a-f]{1,4}:){1,7}:|(?:[0-9a-f]{1,4}:){1,6}:[0-9a-f]{1,4}|(?:[0-9a-f]{1,4}:){1,5}(?::[0-9a-f]{1,4}){1,2}|(?:[0-9a-f]{1,4}:){1,4}(?::[0-9a-f]{1,4}){1,3}|(?:[0-9a-f]{1,4}:){1,3}(?::[0-9a-f]{1,4}){1,4}|(?:[0-9a-f]{1,4}:){1,2}(?::[0-9a-f]{1,4}){1,5}|[0-9a-f]{1,4}:(?:(?::[0-9a-f]{1,4}){1,6})|:(?:(?::[0-9a-f]{1,4}){1,7}|:))\\]|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))(?!:443$)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"}
  },
  "examples": [{
    "format": "gorce.provider/v1",
    "provider_id": "mock-web-search",
    "display_name": "Deterministic Mock Web Search",
    "version": "1.0.0",
    "publisher": {"name": "Fixture", "fingerprint": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"},
    "package": {"files": [{"path": "bin/mock-web-search", "size": 29, "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}], "executable": {"path": "bin/mock-web-search", "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}},
    "auth_methods": [{"kind": "api_key", "id": "search_api_key", "credential_class": "search-api-key", "label": "Search API key"}],
    "capabilities": {"auth_method_ids": ["search_api_key"], "credential_classes": ["search-api-key"], "network_origins": []},
    "tools": [{"name": "web_search", "description": "Search", "input_schema": {"type": "object", "additionalProperties": false}, "output_schema": {"type": "object", "additionalProperties": false}, "side_effects": ["network_read"], "auth_method_id": "search_api_key", "credential_class": "search-api-key", "network_origins": []}]
  }]
}
