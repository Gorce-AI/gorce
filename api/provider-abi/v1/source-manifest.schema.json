            "mode": 33261
          }
        ],
        "executable": {
          "path": "bin/provider",
          "sha256": "cca726f4312f10d31623e1e22a0493fd92b93159ce1346cf49b10c12f3126528"
        }
      },
      "auth_methods": [
        {
          "kind": "api_key",
          "id": "search_api_key",
          "credential_class": "search-api-key",
          "label": "Search API key"
        }
      ],
      "capabilities": {
        "auth_method_ids": [
          "search_api_key"
        ],
        "credential_classes": [
          "search-api-key"
        ],
        "network_origins": []
      },
      "tools": [
        {
          "name": "web_search",
          "description": "Search",
          "input_schema": {
            "type": "object",
            "additionalProperties": false
          },
          "output_schema": {
            "type": "object",
            "additionalProperties": false
          },
          "side_effects": [
            "network_read"
          ],
          "auth_method_id": "search_api_key",
          "credential_class": "search-api-key",
          "network_origins": []
        }
      ]
    }
  ]
}
