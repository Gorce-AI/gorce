{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.ai/schemas/s1-cutover.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verdict",
    "workspace_manifest_sha256",
    "source_commit",
    "task6_baseline_sha256",
    "builder_bun",
    "release_claim",
    "scope",
    "checks"
  ],
  "properties": {
    "schema": { "const": "gorce.s1.cutover/v1" },
    "verdict": { "enum": ["APPROVED", "CHANGES_REQUESTED"] },
    "workspace_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "task6_baseline_sha256": {
      "const": "67b95cadb3ec9a711992007d2df420d984d97cfb9da94b033567e9b7987365a2"
    },
    "builder_bun": { "const": "1.3.14" },
    "release_claim": { "const": false },
    "scope": { "const": "S1 native validation only; not release qualified" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ok", "code", "reason"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "code": { "type": "string", "pattern": "^S1_[A-Z0-9_]+$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "APPROVED" } } },
      "then": {
        "properties": {
          "checks": { "not": { "contains": { "properties": { "ok": { "const": false } } } } }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "CHANGES_REQUESTED" } } },
      "then": {
        "properties": { "checks": { "contains": { "properties": { "ok": { "const": false } } } } }
      }
    }
  ]
}
