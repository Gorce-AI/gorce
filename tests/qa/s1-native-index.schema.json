{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.ai/schemas/s1-native-index.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_commit",
    "task6_baseline_sha256",
    "builder_bun",
    "release_claim",
    "scope",
    "entries",
    "aggregate"
  ],
  "properties": {
    "schema": { "const": "gorce.s1.native-index/v1" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "task6_baseline_sha256": {
      "const": "67b95cadb3ec9a711992007d2df420d984d97cfb9da94b033567e9b7987365a2"
    },
    "builder_bun": { "const": "1.3.14" },
    "release_claim": { "const": false },
    "scope": { "const": "S1 native validation only; not release qualified" },
    "aggregate": { "const": "native-hello-only" },
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "schema",
          "target",
          "source_commit",
          "task6_baseline_sha256",
          "builder_bun",
          "release_claim",
          "scope",
          "runner_os",
          "runner_arch",
          "artifact",
          "artifact_sha256",
          "copied_outside_source",
          "exit_code",
          "stderr",
          "stdout",
          "payload",
          "native_execution"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "schema": { "const": "gorce.s1.native-hello/v1" },
          "target": { "type": "string", "pattern": "^bun-(linux|darwin|windows)-(x64|arm64)$" },
          "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "task6_baseline_sha256": {
            "const": "67b95cadb3ec9a711992007d2df420d984d97cfb9da94b033567e9b7987365a2"
          },
          "builder_bun": { "const": "1.3.14" },
          "release_claim": { "const": false },
          "scope": { "const": "S1 native validation only; not release qualified" },
          "runner_os": { "enum": ["linux", "darwin", "win32"] },
          "runner_arch": { "enum": ["x64", "arm64"] },
          "artifact": { "type": "string", "minLength": 1 },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "copied_outside_source": { "const": true },
          "exit_code": { "const": 0 },
          "stderr": { "const": "" },
          "stdout": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" },
          "native_execution": { "const": true }
        }
      }
    }
  }
}
