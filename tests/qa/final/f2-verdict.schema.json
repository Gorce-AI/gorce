{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.ai/schemas/f2-verdict.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verdict", "fixture_manifest_sha256", "cases"],
  "properties": {
    "schema": { "const": "gorce.f2-verdict/v1" },
    "verdict": { "enum": ["APPROVED", "CHANGES_REQUESTED"] },
    "fixture_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "expected_code",
          "expected_reason",
          "observed_code",
          "observed_reason",
          "ok",
          "error_count"
        ],
        "properties": {
          "kind": { "enum": ["plan", "runtime-overlay", "published-source-overlay"] },
          "id": { "type": "string" },
          "expected_code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "expected_reason": { "type": "string", "minLength": 1 },
          "observed_code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "observed_reason": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "error_count": { "type": "integer", "minimum": 0 }
        },
        "oneOf": [
          {
            "properties": {
              "id": { "const": "clean" },
              "expected_code": { "const": "NONE" },
              "expected_reason": { "const": "clean sovereign sibling trees are approved" }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "NONE" },
                    "observed_reason": { "const": "clean sovereign sibling trees are approved" }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": { "const": "package-inversion" },
              "expected_code": { "const": "ECO_CORE_PACKAGE_INVERSION" },
              "expected_reason": { "const": "core must not depend on Studio or JetBrains packages" }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_CORE_PACKAGE_INVERSION" },
                    "observed_reason": {
                      "const": "core must not depend on Studio or JetBrains packages"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": { "const": "product-inventory-in-core" },
              "expected_code": { "const": "ECO_CORE_PRODUCT_INVENTORY" },
              "expected_reason": {
                "const": "core must not contain Studio or JetBrains production inventory"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_CORE_PRODUCT_INVENTORY" },
                    "observed_reason": {
                      "const": "core must not contain Studio or JetBrains production inventory"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": { "const": "source-tunneling" },
              "expected_code": { "const": "ECO_SOURCE_TUNNELING" },
              "expected_reason": {
                "const": "core must not tunnel to a sibling source tree or unpublished dependency"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_SOURCE_TUNNELING" },
                    "observed_reason": {
                      "const": "core must not tunnel to a sibling source tree or unpublished dependency"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": { "const": "wrong-bun-version" },
              "expected_code": { "const": "ECO_TECHNOLOGY_VERSION" },
              "expected_reason": {
                "const": "Bun 1.3.14, TypeScript 6.0.3, and Biome 2.2.4 are required in core and Studio"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_TECHNOLOGY_VERSION" },
                    "observed_reason": {
                      "const": "Bun 1.3.14, TypeScript 6.0.3, and Biome 2.2.4 are required in core and Studio"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": { "const": "wrong-typescript-version" },
              "expected_code": { "const": "ECO_TECHNOLOGY_VERSION" },
              "expected_reason": {
                "const": "Bun 1.3.14, TypeScript 6.0.3, and Biome 2.2.4 are required in core and Studio"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_TECHNOLOGY_VERSION" },
                    "observed_reason": {
                      "const": "Bun 1.3.14, TypeScript 6.0.3, and Biome 2.2.4 are required in core and Studio"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": { "const": "alternate-package-manager" },
              "expected_code": { "const": "ECO_ALTERNATE_PACKAGE_MANAGER" },
              "expected_reason": {
                "const": "alternate package-manager locks are forbidden: pnpm-lock.yaml"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_ALTERNATE_PACKAGE_MANAGER" },
                    "observed_reason": {
                      "const": "alternate package-manager locks are forbidden: pnpm-lock.yaml"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": { "const": "alternate-core-entrypoint" },
              "expected_code": { "const": "ECO_ALTERNATE_CORE_ENTRYPOINT" },
              "expected_reason": {
                "const": "core must not introduce a Node or non-Bun alternate entrypoint; Bun exports and bin are permitted"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_ALTERNATE_CORE_ENTRYPOINT" },
                    "observed_reason": {
                      "const": "core must not introduce a Node or non-Bun alternate entrypoint; Bun exports and bin are permitted"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": { "const": "jetbrains-host-code-displacement" },
              "expected_code": { "const": "ECO_JETBRAINS_HOST_DISPLACEMENT" },
              "expected_reason": {
                "const": "JetBrains host code must remain in the JetBrains repository"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_JETBRAINS_HOST_DISPLACEMENT" },
                    "observed_reason": {
                      "const": "JetBrains host code must remain in the JetBrains repository"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": {
                "enum": [
                  "alternate-cargo-runtime",
                  "alternate-node-runtime",
                  "alternate-deno-runtime",
                  "alternate-non-bun-runtime"
                ]
              },
              "expected_code": { "const": "ECO_NON_BUN_RUNTIME" },
              "expected_reason": {
                "const": "core ecosystem trees must use Bun rather than Cargo, Node, Deno, or another runtime"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_NON_BUN_RUNTIME" },
                    "observed_reason": {
                      "const": "core ecosystem trees must use Bun rather than Cargo, Node, Deno, or another runtime"
                    }
                  }
                }
              }
            ]
          },
          {
            "properties": {
              "id": {
                "enum": [
                  "published-link-source",
                  "published-file-source",
                  "published-relative-source",
                  "published-absolute-source",
                  "published-git-plus-source",
                  "published-raw-git-source",
                  "published-github-shorthand-source",
                  "published-gradle-files-source",
                  "published-gradle-project-source"
                ]
              },
              "expected_code": { "const": "ECO_PUBLISHED_SOURCE_TUNNELING" },
              "expected_reason": {
                "const": "siblings must consume published immutable artifacts only"
              }
            },
            "allOf": [
              {
                "if": { "properties": { "ok": { "const": true } } },
                "then": {
                  "properties": {
                    "observed_code": { "const": "ECO_PUBLISHED_SOURCE_TUNNELING" },
                    "observed_reason": {
                      "const": "siblings must consume published immutable artifacts only"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "fatal_code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "fatal_reason": { "type": "string", "minLength": 1 }
  }
}
