{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.ai/schemas/f2-verdict.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verdict", "fixture_manifest_sha256", "cases"],
  "properties": {
    "schema": { "const": "gorce.f2-verdict/v1" },
    "verdict": { "enum": ["APPROVED", "CHANGES_REQUESTED"] },
    "fixture_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected", "observed", "ok", "error_count"],
        "properties": {
          "id": { "type": "string" },
          "expected": { "enum": ["APPROVED", "CHANGES_REQUESTED"] },
          "observed": { "enum": ["APPROVED", "CHANGES_REQUESTED"] },
          "ok": { "type": "boolean" },
          "error_count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
