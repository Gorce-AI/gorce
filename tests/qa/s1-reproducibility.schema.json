{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.ai/schemas/s1-reproducibility.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "source_commit",
    "task6_baseline_sha256",
    "builder_bun",
    "release_claim",
    "scope",
    "exit_codes",
    "digests",
    "match"
  ],
  "properties": {
    "schema": { "const": "gorce.s1.reproducibility/v1" },
    "target": { "type": "string", "pattern": "^bun-(linux|darwin|windows)-(x64|arm64)$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "task6_baseline_sha256": {
      "const": "67b95cadb3ec9a711992007d2df420d984d97cfb9da94b033567e9b7987365a2"
    },
    "builder_bun": { "const": "1.3.14" },
    "release_claim": { "const": false },
    "scope": { "const": "S1 native validation only; not release qualified" },
    "exit_codes": { "const": [0, 0] },
    "digests": {
      "type": "array",
      "prefixItems": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "match": { "const": true }
  }
}
