{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorce.ai/schemas/s2-semantic-core.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verdict",
    "source_commit",
    "source_inventory",
    "mutation_binding",
    "task6_baseline_sha256",
    "builder_bun",
    "release_claim",
    "scope",
    "checks"
  ],
  "properties": {
    "schema": { "const": "gorce.s2.semantic-core/v2" },
    "verdict": { "enum": ["APPROVED", "CHANGES_REQUESTED"] },
    "task6_baseline_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "builder_bun": { "const": "1.3.14" },
    "release_claim": { "const": false },
    "scope": { "const": "S2 semantic core only; S3 storage and S4 TUI deferred" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_inventory": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "pattern": "^packages/core/src/[a-z-]+\\.ts$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "mutation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitions", "runner", "runner_support", "tests"],
      "properties": {
        "definitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "src/verification/mutation-s2-targets.ts" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "src/verification/mutation-s2.ts" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "runner_support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "src/verification/mutation-s2-sandbox.ts" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "tests/s2.test.ts" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ok", "code", "reason"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "code": { "type": "string", "pattern": "^S2_[A-Z0-9_]+$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
